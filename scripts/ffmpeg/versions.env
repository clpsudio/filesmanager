# Pinned inputs of the FFmpeg decoder build (libffmpegJNI.so).
# Copyright 2026 CLP Studio. Licensed under the Apache License, Version 2.0
# (see LICENSE.pending-review.md: the licence decision for CLP Studio's code is
# still pending).
#
# Changing ANY value here changes the native library. CI keys its FFmpeg cache on
# this file, scripts/ffmpeg/*.sh and decoder-ffmpeg/src/main/jni/build_ffmpeg.sh.

# FFmpeg: release/6.0 branch, the exact commit Jellyfin's 1.8.0+1 decoder used.
FFMPEG_COMMIT=d388c347d41e4eb516dec05910551c5461e65615
FFMPEG_VERSION_LABEL="FFmpeg 6.0 (release/6.0 branch, RELEASE file 6.0.2, commit d388c347)"
# Source tarball of that commit (GitHub mirror of git.ffmpeg.org/ffmpeg.git).
FFMPEG_TARBALL_URL=https://github.com/FFmpeg/FFmpeg/archive/d388c347d41e4eb516dec05910551c5461e65615.tar.gz
FFMPEG_TARBALL_NAME=ffmpeg-d388c347d41e4eb516dec05910551c5461e65615.tar.gz
FFMPEG_TARBALL_SHA256=f89916923b8b935d1f0aaf8b77d21cb0c507c270d66c00d0f256a62cc7ff22ec
# sha256 of the sorted "sha256sum" list of every file in the extracted tree.
# It does not depend on how the tarball was compressed, so it also checks a
# tree made with `git archive` from the official repository (see fetch-ffmpeg.sh --git).
FFMPEG_TREE_SHA256=1ff7dc0ade0456b1eb72b43e354b8d6c9b6fb90abec0657f4e85f2c560013ffc
FFMPEG_GIT_URL=https://git.ffmpeg.org/ffmpeg.git

# The 11 audio decoders (same list as Jellyfin's build.sh at v1.8.0+1).
FFMPEG_DECODERS="flac alac pcm_mulaw pcm_alaw mp3 aac ac3 eac3 dca mlp truehd"
# Android API level FFmpeg is compiled against (4th argument of build_ffmpeg.sh).
FFMPEG_ANDROID_API=21

# Android NDK r26b (also android.ndkVersion in decoder-ffmpeg/build.gradle.kts).
NDK_VERSION=26.1.10909125
NDK_ZIP_URL=https://dl.google.com/android/repository/android-ndk-r26b-linux.zip
NDK_ZIP_SHA1=fdf33d9f6c1b3f16e5459d53a82c7d2201edbcc4
NDK_ZIP_SHA256=ad73c0370f0b0a87d1671ed2fd5a9ac9acfd1eb5c43a7fbfbd330f85d19dd632

# CMake from the Android SDK (also externalNativeBuild.cmake.version).
CMAKE_VERSION=3.22.1

# Fixed timestamp for the archives these scripts write (2025-05-28T07:57:46Z,
# the commit time of FFMPEG_COMMIT).
SOURCE_DATE_EPOCH=1748419066
